# Identidad y alcance
BOT_NAME=Asistente
# Horas locales en las que el bot reduce su actividad. Vacío = siempre disponible.
BOT_OFFLINE_HOURS=
# Obligatorio para responder: JID o parte del nombre del grupo, separados por coma.
# Vacío = no responde a ningún grupo.
ALLOWED_GROUPS=
# Grupos que solo se observan y registran localmente, sin responder.
SILENT_GROUPS=
# 0 desactiva mensajes espontáneos; 1 o 2 habilita una probabilidad baja.
SPONTANEOUS_LEVEL=0

# LLM (requerido para generar respuestas)
OPENROUTER_API_KEY=
# Opcional: definir un modelo específico o una lista separada por comas de modelos de respaldo.
# OPENROUTER_MODEL=nombre-del-modelo
# OPENROUTER_MODELS=modelo-principal,modelo-respaldo
# OPENROUTER_REASONING=low

# Voz saliente (opcional; se intenta cada proveedor configurado)
TTS_EDGE_VOICE=es-AR-ElenaNeural
TTS_EDGE_RATE=-6%
TTS_EDGE_PITCH=-2Hz
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=
# FISH_AUDIO_API_KEY=
# FISH_AUDIO_VOICE_ID=

# Transcripción local de audio entrante (opcional)
# Instalar ffmpeg y Whisper.cpp; no se incluyen ejecutables ni modelos.
# FFMPEG_PATH=C:/ruta/a/ffmpeg.exe
# WHISPER_BIN=C:/ruta/a/whisper-cli.exe
# WHISPER_MODEL=C:/ruta/a/modelo.bin

# Resumen de contexto por participante, desactivado por defecto.
ENABLE_USER_NOTES=false
